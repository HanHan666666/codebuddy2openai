# Copy to .env and fill in the values you need.
#
# The launcher loads this file automatically. Nothing here is required if you
# pass the equivalent command line flag instead.

# API key the proxy requires from its clients.
# Equivalent to --api-key. Leave unset to run with no authentication.
# WORKBUDDY2OPENAI_KEY=c2o-local-1

# WorkBuddy / CodeBuddy API key, for the direct-key mode that skips the desktop
# session entirely.
# Equivalent to --direct-key.
# Generate one at https://www.codebuddy.ai/profile/keys
# WORKBUDDY_DIRECT_KEY=ck_yourkeyhere

# Path to write the proxy log to.
# Equivalent to --log. Leave unset to log to the console only.
# WORKBUDDY2OPENAI_LOG=c2o.log

# The CODEBUDDY_* spellings of the three variables above still work, so an
# existing .env file needs no changes.
